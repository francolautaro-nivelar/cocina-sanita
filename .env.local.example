NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Aviso por mail a Carla cuando entra un pedido nuevo (Resend — resend.com).
# RESEND_API_KEY: API key de Resend (Dashboard > API Keys).
# ORDER_NOTIFICATION_EMAIL: casilla que recibe el aviso (default: cocinasanita@gmail.com).
# EMAIL_FROM: remitente verificado (default: onboarding@resend.dev, que solo le puede
# mandar a la casilla de tu cuenta de Resend — verificá cocinasanita.com en Resend
# para mandar en serio a ORDER_NOTIFICATION_EMAIL, ver README).
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
EMAIL_FROM=

# Opcional: URL pública del sitio en producción, para armar el link
# "Ver en el panel de pedidos" dentro del mail de aviso.
NEXT_PUBLIC_SITE_URL=
