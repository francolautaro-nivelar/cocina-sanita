NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Aviso por mail a Carla cuando entra un pedido nuevo (Gmail SMTP).
# GMAIL_USER: la casilla que envía y recibe el aviso (cocinasanita@gmail.com).
# GMAIL_APP_PASSWORD: una "contraseña de aplicación" generada en la cuenta de Google
# (myaccount.google.com/apppasswords, con la verificación en 2 pasos activada) —
# NO es la contraseña normal de la cuenta.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opcional: URL pública del sitio en producción, para armar el link
# "Ver en el panel de pedidos" dentro del mail de aviso.
NEXT_PUBLIC_SITE_URL=
